+            cfg_memory_suffix(input.p, input.n, "mb") ||
+            cfg_memory_suffix(input.p, input.n, "g") ||
+            cfg_memory_suffix(input.p, input.n, "gb")) bytes = 0;
+        else if (!cfg_parse_memory(input.p, input.n, bytes)) return false;
